# PostgreSQL
POSTGRES_USER=feedgraph
POSTGRES_PASSWORD=changeme
POSTGRES_DB=feedgraph
# When running backend inside docker-compose, use the service name 'postgres'.
# When running backend locally (npm run start:dev), use 'localhost'.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
# Same docker-vs-local note as POSTGRES_HOST above.
REDIS_HOST=redis
REDIS_PORT=6379

# Backend
PORT=3000
BACKEND_PORT=3000
# development | production | test. In production, /auth responses omit the
# devMode confirmation link (it's still logged); cookies are set Secure.
NODE_ENV=development
# Apply pending TypeORM migrations on backend startup. Set to 'false' in CI
# so tests control schema lifecycle themselves.
RUN_MIGRATIONS_ON_BOOT=true
# Public-facing base URL of the backend; used to build email-confirmation links.
APP_URL=http://localhost:3000

# Auth
# Generate per environment: openssl rand -hex 32 — must be >= 32 chars.
JWT_SECRET=
# Duration suffix: s|m|h|d (e.g. 30m, 12h, 7d).
JWT_EXPIRATION=7d

# Bull Board basic-auth (queue monitoring UI at http://localhost:${BULL_BOARD_PORT})
USER_LOGIN=admin
USER_PASSWORD=changeme
BULL_BOARD_PORT=3030
