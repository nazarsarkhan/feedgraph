# PostgreSQL
POSTGRES_USER=feedgraph
POSTGRES_PASSWORD=changeme
POSTGRES_DB=feedgraph
# When running backend inside docker-compose, use the service name 'postgres'.
# When running backend locally (npm run start:dev), use 'localhost'.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
# Same docker-vs-local note as POSTGRES_HOST above.
REDIS_HOST=redis
REDIS_PORT=6379

# Backend
PORT=3000
BACKEND_PORT=3000
# development | production | test. In production, /auth responses omit the
# devMode confirmation link (it's still logged); cookies are set Secure.
NODE_ENV=development
# Apply pending TypeORM migrations on backend startup. Set to 'false' in CI
# so tests control schema lifecycle themselves.
RUN_MIGRATIONS_ON_BOOT=true
# Public-facing origin of the SPA (nginx in front of the frontend). Used
# to build links surfaced to users (email confirmation, future password
# reset, etc.) — these must land on the SPA, not the API.
APP_URL=http://localhost:8080

# Auth
# Generate per environment: openssl rand -hex 32 — must be >= 32 chars.
JWT_SECRET=
# Duration suffix: s|m|h|d (e.g. 30m, 12h, 7d).
JWT_EXPIRATION=7d

# Feeds
# Max wall-clock budget (ms) for the live rss-parser fetch during feed
# creation. Synchronous in the request path; keep tight.
FEED_VALIDATION_TIMEOUT_MS=10000
# Scheduled feed-poll interval (cron is */N * * * *).
FEED_POLL_INTERVAL_MINUTES=15
# Per-process BullMQ worker concurrency for the feed-poll queue.
FEED_POLL_WORKER_CONCURRENCY=5

# Prefilter
# Minimum trimmed length (chars) of article content_raw (or summaryRaw, if
# content_raw is null) to pass the deterministic pre-filter. Below this,
# the article is filed as status='filtered' and is not sent to the LLM.
PREFILTER_MIN_CONTENT_LENGTH=200
# Max ratio of chars inside <a> tags vs total text in content_raw before
# the article is filtered as link-density-heavy (aggregator / link farm).
PREFILTER_MAX_LINK_DENSITY=0.3
# Per-process BullMQ worker concurrency for the article-prefilter queue.
# Prefilter is fast (pure code, single DB write), so this is higher than
# FEED_POLL_WORKER_CONCURRENCY.
PREFILTER_WORKER_CONCURRENCY=10
# Per-process BullMQ worker concurrency for the article-process queue. The
# LlmService in-process semaphore (LLM_CONCURRENCY) further caps real LLM
# in-flight requests, so this can stay modest.
ARTICLE_PROCESS_WORKER_CONCURRENCY=3

# Bull Board basic-auth (queue monitoring UI at http://localhost:${BULL_BOARD_PORT})
USER_LOGIN=admin
USER_PASSWORD=changeme
BULL_BOARD_PORT=3030

# Frontend (nginx static + reverse proxy to backend). The compose service
# binds this port to container port 80; the nginx config proxies /api/
# to backend:3000 so the browser sees a single origin.
FRONTEND_PORT=8080

# Vite HMR dev server, only used by the profile-gated `frontend-dev` compose
# service: `docker compose --profile dev up -d frontend-dev`. The default
# stack (the nginx `frontend` service) ignores this.
FRONTEND_DEV_PORT=5173


# LLM
# Active provider. 'mock' is a first-class fake adapter that returns
# deterministic well-formed output — reviewers can run the full pipeline
# without any API key. Switch to 'openai' or 'anthropic' only after setting
# the matching API key below.
LLM_ACTIVE_PROVIDER=mock
# Optional secondary provider for soft-degradation failover. Must differ
# from LLM_ACTIVE_PROVIDER. Failover triggers only on retriable errors
# (5xx, 429, network/timeout, schema validation). 4xx auth / bad-request
# errors propagate — secondary would hit the same wall.
# LLM_FAILOVER_PROVIDER=anthropic
# Max simultaneous in-flight LLM requests across the whole Node process
# (in-memory semaphore in LlmService — separate from BullMQ concurrency).
LLM_CONCURRENCY=3
# Hard cap on completion tokens per LLM call.
LLM_MAX_TOKENS_PER_REQUEST=4000
# Required only when LLM_ACTIVE_PROVIDER or LLM_FAILOVER_PROVIDER is
# 'openai'. Conditional check is enforced by env.schema at boot.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Required only when LLM_ACTIVE_PROVIDER or LLM_FAILOVER_PROVIDER is
# 'anthropic'.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Entity deduplication (async on-demand job)
# POST /entities/deduplicate enqueues an ENTITY_DEDUP job that walks the user's
# entity set in batches, calling the LLM matchEntities op per batch and merging.
# BATCH_SIZE bounds how many entities are sent to the LLM per call; the worker
# still processes the full set, one batch at a time. WORKER_CONCURRENCY is the
# BullMQ parallelism for the queue (kept at 1 — each job mutates a whole user's
# entity set in a transaction).
ENTITY_DEDUP_BATCH_SIZE=200
ENTITY_DEDUP_WORKER_CONCURRENCY=1

# Period digests (async on-demand job)
# POST /digests/generate short-circuits to the stored digest if one already
# exists for the (user, period); otherwise it enqueues a DIGEST job that runs
# the buildDigest LLM call on the worker (the HTTP layer never blocks on the
# LLM). WORKER_CONCURRENCY is the BullMQ parallelism for the queue (kept at 1 —
# generation is one round-trip per job and single-flighted per user+period).
DIGEST_WORKER_CONCURRENCY=1

# Demo seed
# When 'true' (default in docker-compose), seed pre-fabricated demo data on
# first boot if not already present. Idempotent — re-running is a no-op.
# Login: demo@feedgraph.local / demo123456. See README.md for details.
SEED_DEMO_ON_BOOT=true
